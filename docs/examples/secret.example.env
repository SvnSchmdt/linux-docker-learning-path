# ⚠️  WARNING: THIS FILE CONTAINS ONLY DUMMY VALUES ⚠️
# ---------------------------------------------------
# This is a template. Copy it to .env and replace with real values.
# NEVER commit .env with real credentials to version control.
# .env is in .gitignore — this file (.example.env) is safe to commit.
# ---------------------------------------------------

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_dummy_password_123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# Application
APP_SECRET_KEY=CHANGE_ME_32_char_random_string_here
APP_PORT=8080
APP_ENV=development

# External APIs (dummy values — replace with real keys)
API_KEY=CHANGE_ME_your_api_key_here
API_SECRET=CHANGE_ME_your_api_secret_here

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
